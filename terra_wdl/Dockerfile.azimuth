# Dockerfile.azimuth
#
# Image for the downstream Azimuth reference-mapping task
# (terra_wdl/hybrid_azimuth_task.R). Built into:
#   majidfarhadloo/scrna_processing_azimuth
#
# Base: bioconductor/bioconductor_docker:RELEASE_3_18
#   - R 4.3.x with Bioconductor 3.18 preconfigured
#   - All Bioc system deps preinstalled (libbz2, liblzma, zlib, libdeflate,
#     libncurses, libhts, etc.), Makevars set up for C++14/17
#   - Eliminates Rhtslib/Rsamtools/rtracklayer/glmGamPoi build cascade
#     failures we hit on rocker/r-ver:4.3.2
# Layered with:
#   - Seurat 5 + SeuratObject
#   - Azimuth + SeuratDisk
#   - anndata (R) for direct h5ad reads
#   - reticulate + Python helpers (h5py, anndata, numpy, scipy)
#   - optparse, tidyverse, SparseM, Matrix
#
# BUILD CONTEXT: repository root.
#   docker build -f terra_wdl/Dockerfile.azimuth -t majidfarhadloo/scrna_processing_azimuth:latest .
#
# GitHub Actions: see .github/workflows/build-azimuth-image.yml.

FROM bioconductor/bioconductor_docker:RELEASE_3_18

ENV DEBIAN_FRONTEND=noninteractive

# ---------------------------------------------------------------------------
# Additional system deps not already in the Bioc base
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-dev \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Python helpers used by R::reticulate to read h5ad files
# ---------------------------------------------------------------------------
RUN pip3 install --no-cache-dir --break-system-packages \
    anndata==0.10.7 \
    h5py==3.11.0 \
    numpy==1.26.4 \
    pandas==2.2.2 \
    scipy==1.13.0 \
  || pip3 install --no-cache-dir \
    anndata==0.10.7 \
    h5py==3.11.0 \
    numpy==1.26.4 \
    pandas==2.2.2 \
    scipy==1.13.0

# ---------------------------------------------------------------------------
# Core R packages (CRAN)
# ---------------------------------------------------------------------------
RUN R -e "install.packages(c('optparse','tidyverse','SparseM','Matrix','remotes'), repos='https://cloud.r-project.org')"

# Seurat ecosystem
RUN R -e "install.packages(c('Seurat','SeuratObject'), repos='https://cloud.r-project.org')"

# SeuratDisk (GitHub release)
RUN R -e "remotes::install_github('mojaveazure/seurat-disk', upgrade='never')"

# anndata for R
RUN R -e "install.packages('anndata', repos='https://cloud.r-project.org')"

# Bioconductor dependencies required by Azimuth.
# Base image already provides BiocManager wired to Bioc 3.18 and all required
# system libs. We install in two waves and assert success between them.
RUN R -e "BiocManager::install(c('Biostrings','GenomicRanges','GenomicFeatures','S4Vectors','IRanges','Rsamtools','rtracklayer','BSgenome','ensembldb','AnnotationFilter','AnnotationDbi','CNEr','TFBSTools','JASPAR2020','motifmatchr'), update=FALSE, ask=FALSE, dependencies=TRUE)"
RUN R -e "stopifnot(all(c('Rsamtools','rtracklayer','BSgenome','ensembldb','TFBSTools') %in% rownames(installed.packages())))"
RUN R -e "BiocManager::install(c('BSgenome.Hsapiens.UCSC.hg38','EnsDb.Hsapiens.v86','glmGamPoi','Signac'), update=FALSE, ask=FALSE, dependencies=TRUE)"
RUN R -e "stopifnot(all(c('BSgenome.Hsapiens.UCSC.hg38','EnsDb.Hsapiens.v86','glmGamPoi','Signac','TFBSTools') %in% rownames(installed.packages())))"

# Azimuth (GitHub release). Fail fast if install_github skipped Azimuth
# silently (it returns success even when deps are missing).
RUN R -e "remotes::install_github('satijalab/azimuth', upgrade='never'); stopifnot('Azimuth' %in% rownames(installed.packages()))"

# Verify imports
RUN R -e "library(Seurat); library(SeuratObject); library(SeuratDisk); library(Azimuth); library(anndata); library(optparse); cat('R import smoke test passed\n')"

# ---------------------------------------------------------------------------
# Pipeline scripts
# ---------------------------------------------------------------------------
RUN mkdir -p /opt/pipeline
COPY terra_wdl/hybrid_azimuth_task.R /opt/pipeline/hybrid_azimuth_task.R
COPY terra_wdl/prep_azimuth_references.R /opt/pipeline/prep_azimuth_references.R
RUN chmod +x /opt/pipeline/hybrid_azimuth_task.R /opt/pipeline/prep_azimuth_references.R

WORKDIR /work

CMD ["Rscript", "/opt/pipeline/hybrid_azimuth_task.R", "--help"]
